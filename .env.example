# ---------------------------------------------------------------------------
# NutriCasa2050 — variaveis de ambiente
#
# Copie este arquivo para .env antes de comecar:
#     cp .env.example .env
#
# O .env NAO vai para o repositorio (esta no .gitignore).
# O .env.example VAI, para que todos saibam quais variaveis existem.
# ---------------------------------------------------------------------------

# Ambiente: development | test
NUTRICASA2050_ENVIRONMENT=development

# ================================ BANCOS ===================================
# Sao DOIS bancos SQLite separados, de proposito. Rodar os testes nao pode
# apagar nem sujar os resultados da simulacao de verdade.
#
# Formato:  sqlite:///caminho/relativo.db    (tres barras)
#           sqlite:////caminho/absoluto.db   (quatro barras)

# Banco PRINCIPAL: usado na simulacao de verdade. Nao e usado nos testes.
NUTRICASA2050_DB_URL=sqlite:///var/nutricasa2050.db

# Banco de TESTE: recriado do zero a cada rodada de pytest.
NUTRICASA2050_TEST_DB_URL=sqlite:///var-test/nutricasa2050_test.db
